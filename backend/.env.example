# --- LLM provider selection -------------------------------------------------
# Which provider to use: "groq" (default) or "openrouter".
# Switching provider only requires changing this + the matching key below.
LLM_PROVIDER=groq

# Groq (default). Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter fallback. Get a key at https://openrouter.ai/keys
# Only used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides. Leave blank to use per-provider defaults.
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=

# --- Server -----------------------------------------------------------------
PORT=3001
# Comma-separated list of allowed origins for CORS (frontend dev server).
CORS_ORIGIN=http://localhost:5173
