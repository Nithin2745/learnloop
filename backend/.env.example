# --- LLM providers & fallback chain ----------------------------------------
# LearnLoop tries providers in order and automatically falls through to the
# next one on a rate-limit / server / rejected-key error. Only providers whose
# API key is set below are used, so unconfigured ones are skipped.
#
# Order precedence:
#   1. LLM_PROVIDER_ORDER  (comma list, highest priority)
#   2. LLM_PROVIDER        (legacy single value; pinned first, others follow)
#   3. built-in default:   gemini, groq, nvidia, openrouter
#
# Recommended order for free tiers (see config.js for the reasoning):
# LLM_PROVIDER_ORDER=gemini,groq,nvidia,openrouter

# Legacy: pin the primary provider (kept for back-compat). Leave as-is or unset.
LLM_PROVIDER=groq

# Gemini (Google AI Studio) — most generous free tier, no credit card.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — fastest, but a small free tokens-per-minute (TPM) window.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM — free OpenAI-compatible endpoints.
# Get a key at https://build.nvidia.com (open a model, then "Get API Key")
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter — ":free" models exist but are often rate-limited upstream.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides. Per-provider model: GROQ_MODEL / GEMINI_MODEL /
# NVIDIA_MODEL / OPENROUTER_MODEL. Global LLM_MODEL / LLM_BASE_URL apply to the
# primary provider only.
# GEMINI_MODEL=gemini-2.5-flash
# LLM_MODEL=
# LLM_BASE_URL=
# Max completion tokens (default 12000). Lower to ~4000 to stretch a tight TPM
# budget; very large multi-depth Learn payloads may truncate below ~8000.
# LLM_MAX_TOKENS=12000

# --- Server -----------------------------------------------------------------
PORT=3001
# Comma-separated list of allowed origins for CORS (frontend dev server).
CORS_ORIGIN=http://localhost:5173

# --- Auth / Supabase --------------------------------------------------------
# Required. Every /api/* generation route requires a valid Supabase JWT, which
# the backend verifies against this project's public JWKS
# (${SUPABASE_URL}/auth/v1/.well-known/jwks.json) — no server-side secret needed.
# Find it in the Supabase dashboard: Project Settings -> API -> Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional: only for legacy projects that sign JWTs with HS256 (a shared secret)
# instead of the default ES256 asymmetric keys. Keep this out of git.
# SUPABASE_JWT_SECRET=
