# Base URL for the backend API.
# Leave blank in dev — vite.config.js proxies /api to http://localhost:3001.
# In production set this to your deployed backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# --- Supabase (auth) --------------------------------------------------------
# Required. LearnLoop signs users in with Supabase (Google OAuth) before any
# study endpoint can be used. Both values are PUBLIC / browser-safe (the anon
# key is protected by row-level security) — never put the service-role key or
# JWT secret here. Find them in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
